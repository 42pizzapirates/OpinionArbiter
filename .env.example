# ==================== 服务器配置 ====================
HOST=0.0.0.0
PORT=5000
LOG_LEVEL=INFO

# ==================== 数据库配置 ====================
DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=media_crawler_v1
DB_CHARSET=utf8mb4

# ==================== LLM API 配置 ====================

# Insight Agent — 推荐 Kimi (https://platform.moonshot.cn/)
INSIGHT_ENGINE_API_KEY=
INSIGHT_ENGINE_BASE_URL=https://api.moonshot.cn/v1
INSIGHT_ENGINE_MODEL_NAME=kimi-k2.6
INSIGHT_ENGINE_MODEL_PROVIDER=openai

# Media Agent — 推荐 Gemini
MEDIA_ENGINE_API_KEY=
MEDIA_ENGINE_BASE_URL=https://api.openai-proxy.org/v1
MEDIA_ENGINE_MODEL_NAME=gemini-2.5-pro
MEDIA_ENGINE_MODEL_PROVIDER=openai

# Report Agent — 推荐 Gemini
REPORT_ENGINE_API_KEY=
REPORT_ENGINE_BASE_URL=https://api.openai-proxy.org/v1
REPORT_ENGINE_MODEL_NAME=gemini-2.5-pro
REPORT_ENGINE_MODEL_PROVIDER=openai

# Host Agent — 推荐 DeepSeek (https://www.deepseek.com/)
HOST_API_KEY=
HOST_BASE_URL=https://api.deepseek.com
HOST_MODEL_NAME=deepseek-chat
HOST_MODEL_PROVIDER=openai

# ==================== 网络搜索配置 ====================
SEARCH_TOOL_TYPE=TavilyAPI
TAVILY_API_KEY=

# Bocha API (可选)
BOCHA_API_KEY=
BOCHA_BASE_URL=https://api.bocha.cn/v1/ai-search

# Anspire API (可选)
ANSPIRE_API_KEY=
ANSPIRE_BASE_URL=https://plugin.anspire.cn/api/ntsearch/search

# ==================== 研究引擎 ====================
MAX_SECTIONS=5
MAX_CONTENT_LENGTH=500000
SEARCH_CONTENT_MAX_LENGTH=20000
SEARCH_TIMEOUT=240
SAVE_INTERMEDIATE_STATES=true

# ==================== Insight vector retrieval ====================
INSIGHT_VECTOR_ENABLED=true
MILVUS_URI=tcp://192.168.200.125:19530
MILVUS_USER=root
MILVUS_PASSWORD=
MILVUS_DB_NAME=default
MILVUS_INSIGHT_COLLECTION=insight_evidence
INSIGHT_EMBEDDING_MODEL=D:\ai_models\modelscope_cache\models\BAAI\bge-m3
INSIGHT_DENSE_DIM=1024
INSIGHT_VECTOR_TOP_K=80
INSIGHT_SYNC_BATCH_SIZE=64

# ==================== Insight semantic clustering ====================
INSIGHT_CLUSTERING_ENABLED=true
INSIGHT_CLUSTER_MODEL=D:\ai_models\modelscope_cache\models\paraphrase-multilingual-MiniLM-L12-v2
INSIGHT_CLUSTER_MAX_RECORDS=300
INSIGHT_CLUSTER_MAX_CLUSTERS=12
INSIGHT_CLUSTER_MIN_CLUSTER_SIZE=3

# uv sync --python 3.11 --all-extras